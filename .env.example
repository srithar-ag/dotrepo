# ==============================================================================
# DotRepo Environment Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# FRONTEND / CLIENT-SIDE (Vite Public Configuration)
# ------------------------------------------------------------------------------
# Supabase project URL (Public)
VITE_SUPABASE_URL="https://your-project-id.supabase.co"

# Supabase Anonymous/Publishable Key (Public - protected via Row Level Security)
VITE_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# Razorpay Key ID (Public - used by Razorpay Checkout script in the browser)
VITE_RAZORPAY_KEY_ID="rzp_test_YourKeyIdHere"


# ------------------------------------------------------------------------------
# BACKEND / SERVERLESS FUNCTIONS ONLY (Never expose in browser or prefix with VITE_)
# ------------------------------------------------------------------------------
# Supabase URL and Service Role Key (Bypasses RLS for secure server-side mutations)
SUPABASE_URL="https://your-project-id.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# Razorpay Secret Key (Used exclusively for server-authoritative HMAC signature verification)
RAZORPAY_KEY_ID="rzp_test_YourKeyIdHere"
RAZORPAY_KEY_SECRET="YourRazorpaySecretKeyHere"

# Razorpay Webhook Secret (Configured in Razorpay Dashboard > Webhooks)
RAZORPAY_WEBHOOK_SECRET="YourRazorpayWebhookSecretHere"

# Resend Email Integration (Optional: automated verification & onboarding dispatches)
RESEND_API_KEY="re_YourResendApiKeyHere"
RESEND_FROM_EMAIL="DotRepo Admissions <admissions@dotrepo.com>"

# Application Base URL (For absolute email links and webhook origin checks)
APP_URL="https://dotrepo.com"

# Administrator Password / Secret Key (Used on /admin login portal)
ADMIN_SECRET_KEY="admin-authorized-demo"

# Administrator Authorized Emails (Comma-separated server-side allowlist)
ADMIN_EMAILS="sritharag17@gmail.com"
